    <!-- SERIGY &#8212; script de muta&#231;&#227;o DOM para serigyLoadSection -->
    <script>
    (function(){
      function init(){
        document.querySelectorAll('[serigyitem="filtroPesquisa"]').forEach(function(f){
          var btn = f.querySelector('button[serigyExecuteWaitSection]');
          if (!btn) return;
          btn.addEventListener('click', function(){
            var sid = btn.getAttribute('serigyExecuteWaitSection');
            var sel = f.querySelector('[serigyitem="historicoExercicio"]');
            var yr  = sel ? sel.value : new Date().getFullYear();
            var tbl = document.querySelector('[serigyLoadSection="' + sid + '"]');
            if (tbl) {
              var cap = tbl.querySelector('caption');
              if (!cap) {
                cap = document.createElement('caption');
                tbl.insertBefore(cap, tbl.firstChild);
              }
              cap.textContent = 'Exerc&#237;cio: ' + yr;
            }
          });
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
    </script>

