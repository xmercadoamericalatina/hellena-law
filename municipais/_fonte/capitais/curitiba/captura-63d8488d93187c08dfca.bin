    <script type="text/javascript">

        var ultimaPesquisa;

        function pesquisarClick() {
            if (ultimaPesquisa != null && ultimaPesquisa != undefined) {
                $("#alterado_conteudo").html($("#alterado_conteudo").html().replaceAll('<span style="background-color: yellow">' + ultimaPesquisa + '</span>', ultimaPesquisa));
            }

            if (validarPesquisa()) {
                $("#alterado_conteudo").html($("#alterado_conteudo").html().replaceAll($("#find-text").val(), "<span style='background-color: yellow'>" + $("#find-text").val() + "</span>"));
                ultimaPesquisa = $("#find-text").val();
            }
        }

        //esta funcao valida se a pesquisa do usuario nao e uma tag html, porque se for não pode executar a funcao acima
        function validarPesquisa() {
            for (var i = 0; i < document.getElementsByTagName("*").length; i++) {
                if (document.getElementsByTagName("*")[i].tagName.toLocaleLowerCase().indexOf($("#find-text").val()) != -1)
                    return false;
            }

            return true;
        }
    </script>
</head>
